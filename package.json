{
  "name": "jarvis",
  "private": true,
  "version": "1.4.1",
  "description": "JARVIS - Configurable profile launcher",
  "author": "Gustavo Pontes",
  "repository": {
    "type": "git",
    "url": "https://github.com/gusp0ntes/JARVIS.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "concurrently --kill-others \"vite\" \"wait-on http://localhost:5173 && node scripts/start-electron.cjs\"",
    "typecheck": "tsc -b",
    "lint": "oxlint . --ignore-path .gitignore",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "electron": "node scripts/start-electron.cjs",
    "vpn:auto:install": "py -3 -m pip install -r electron/vpn-auto/requirements.txt",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "publish": {
      "provider": "github",
      "owner": "gusp0ntes",
      "repo": "JARVIS",
      "releaseType": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "electron/vpn-auto/**/*",
      "electron/*.ps1"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "JARVIS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "JARVIS"
    }
  }
}
