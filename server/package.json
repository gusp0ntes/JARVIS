{
  "name": "jarvis-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "mongoose": "^9.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "mongodb-memory-server-core": "^11.4.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2"
  }
}
